<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <!-- The same real BepInEx/Harmony packages resolved by the plugin, without native Unity. -->
    <PackageReference Include="BepInEx.Core" Version="5.4.21" ExcludeAssets="build" />
    <Compile Include="../../src/ModConfig.cs" Link="Production/ModConfig.cs" />
    <Compile Include="../../src/TakeoffMusicPool.cs" Link="Production/TakeoffMusicPool.cs" />
    <Compile Include="../../src/MusicPlaybackState.cs" Link="Production/MusicPlaybackState.cs" />
    <Compile Include="../../src/TakeoffMusicContext.cs" Link="Production/TakeoffMusicContext.cs" />
    <Compile Include="../../src/Patches/TakeoffMusicRequestPatch.cs" Link="Production/TakeoffMusicRequestPatch.cs" />
  </ItemGroup>
</Project>
